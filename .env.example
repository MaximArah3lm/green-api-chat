# Адрес API. Можно оставить по умолчанию или указать apiUrl из личного кабинета GREEN-API
VITE_API_URL=https://api.green-api.com

# Необязательно: данные инстанса, чтобы форма входа заполнялась автоматически при разработке.
# Все переменные VITE_* попадают в собранный бандл, поэтому для деплоя токен здесь не указывайте.
VITE_ID_INSTANCE=
VITE_API_TOKEN_INSTANCE=
